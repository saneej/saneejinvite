rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-@\\.]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isCollaborator(userId) {
      return isSignedIn() && (
        isOwner(userId) || (
          request.auth.token.email_verified == true && 
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/users/$(userId)/collaborators/$(request.auth.token.email))
        )
      );
    }

    // Entity Validations
    function isValidGuest(data, userId) {
      return data.keys().hasAll(['name', 'category', 'status', 'createdAt', 'ownerId'])
        && data.keys().size() <= 12
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category.size() > 0
        && data.status in ['Not Invited', 'Invited', 'Confirmed', 'Not Coming']
        && (data.createdAt is timestamp || data.createdAt is map)
        && (data.get('phone', '') is string)
        && (data.get('notes', '') is string)
        && (data.get('suggestedBy', '') is string)
        && (data.get('primaryCaller', '') is string)
        && data.ownerId == userId;
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll(['name', 'ownerId'])
        && data.keys().size() <= 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId == userId;
    }

    function isValidSettings(data, userId) {
      return data.keys().hasAll(['brideName', 'groomName', 'weddingDate', 'venue', 'whatsappTemplate', 'greetingMessage', 'invitationTone', 'ownerId'])
        && data.keys().size() <= 8
        && data.brideName is string && data.brideName.size() <= 100
        && data.groomName is string && data.groomName.size() <= 100
        && data.weddingDate is string && data.weddingDate.size() <= 100
        && data.venue is string && data.venue.size() <= 1000
        && data.whatsappTemplate is string && data.whatsappTemplate.size() <= 5000
        && data.greetingMessage is string && data.greetingMessage.size() <= 1000
        && data.invitationTone is string && data.invitationTone.size() <= 1000
        && data.ownerId == userId;
    }

    function isValidLog(data, userId) {
      return data.keys().hasAll(['action', 'details', 'timestamp', 'ownerId'])
        && data.keys().size() <= 10
        && data.action is string && data.details is string
        && (data.timestamp is timestamp || data.timestamp is map)
        && data.ownerId == userId;
    }

    function isValidCollaborator(data) {
      return data.keys().hasAll(['email', 'role', 'name', 'addedAt'])
        && data.keys().size() <= 5
        && data.email is string && data.role is string && data.name is string;
    }

    match /users/{userId}/collaborators/{collabEmail} {
      allow list: if isSignedIn() && (request.auth.uid == userId || exists(/databases/$(database)/documents/users/$(userId)/collaborators/$(request.auth.token.email)));
      allow get: if isSignedIn() && (request.auth.uid == userId || exists(/databases/$(database)/documents/users/$(userId)/collaborators/$(request.auth.token.email)));
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isCollaborator(userId);
      allow list: if isSignedIn(); 
      
      match /guests/{guestId} {
        allow list: if isCollaborator(userId);
        allow get: if isCollaborator(userId);
        allow create: if isCollaborator(userId) && isValidGuest(incoming(), userId);
        allow update: if isCollaborator(userId) && isValidGuest(incoming(), userId);
        allow delete: if isCollaborator(userId);
      }

      match /categories/{categoryId} {
        allow list: if isCollaborator(userId);
        allow get: if isCollaborator(userId);
        allow create: if isCollaborator(userId) && isValidCategory(incoming(), userId);
        allow update: if isCollaborator(userId) && isValidCategory(incoming(), userId);
        allow delete: if isCollaborator(userId);
      }

      match /settings/{settingId} {
        allow get: if isCollaborator(userId);
        allow list: if isCollaborator(userId);
        allow create: if isCollaborator(userId) && isValidSettings(incoming(), userId);
        allow update: if isCollaborator(userId) && isValidSettings(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      match /logs/{logId} {
        allow list: if isCollaborator(userId);
        allow get: if isCollaborator(userId);
        allow create: if isCollaborator(userId) && isValidLog(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }

    match /shared_lists/{sharedId} {
      allow get: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }
  }
}
