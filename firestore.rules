rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return request.auth.uid == userId; }

    // Entity Validations
    function isValidGuest(data) {
      return data.keys().hasAll(['name', 'category', 'status', 'createdAt', 'ownerId'])
        && data.keys().size() <= 10
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category.size() > 0
        && data.status in ['Not Invited', 'Invited', 'Confirmed', 'Not Coming']
        && (data.createdAt is timestamp || data.createdAt is map)
        && (data.get('phone', '') is string)
        && (data.get('notes', '') is string)
        && data.ownerId == request.auth.uid;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'ownerId'])
        && data.keys().size() <= 5
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId == request.auth.uid;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['brideName', 'groomName', 'weddingDate', 'venue', 'whatsappTemplate', 'greetingMessage', 'invitationTone', 'telegramEnabled', 'ownerId'])
        && data.keys().size() <= 11
        && data.brideName is string && data.brideName.size() <= 100
        && data.groomName is string && data.groomName.size() <= 100
        && data.weddingDate is string && data.weddingDate.size() <= 100
        && data.venue is string && data.venue.size() <= 1000
        && data.whatsappTemplate is string && data.whatsappTemplate.size() <= 5000
        && data.greetingMessage is string && data.greetingMessage.size() <= 1000
        && data.invitationTone is string && data.invitationTone.size() <= 1000
        && data.telegramEnabled is bool
        && (data.get('telegramBotToken', '') is string)
        && data.ownerId == request.auth.uid;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['action', 'details', 'timestamp', 'ownerId'])
        && data.keys().size() <= 10
        && data.action is string && data.details is string
        && (data.timestamp is timestamp || data.timestamp is map)
        && data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      
      match /guests/{guestId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGuest(incoming());
        allow update: if isOwner(userId) && isValidGuest(incoming()) && (
          incoming().ownerId == existing().ownerId
        );
        allow delete: if isOwner(userId);
      }

      match /categories/{categoryId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCategory(incoming());
        allow update: if isOwner(userId) && isValidCategory(incoming()) && (
          incoming().ownerId == existing().ownerId
        );
        allow delete: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSettings(incoming());
        allow update: if isOwner(userId) && isValidSettings(incoming()) && (
          incoming().ownerId == existing().ownerId
        );
        allow delete: if isOwner(userId);
      }

      match /logs/{logId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
