{
  "entities": {
    "Guest": {
      "title": "Guest",
      "description": "A wedding guest entry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the guest" },
        "phone": { "type": "string", "description": "Phone or WhatsApp number" },
        "category": { "type": "string", "description": "Category name" },
        "notes": { "type": "string", "description": "Extra details" },
        "status": { "type": "string", "enum": ["Not Invited", "Invited", "Confirmed", "Not Coming"] },
        "suggestedBy": { "type": "string", "description": "Name or Role of the person who suggested this guest (e.g., Dad, Groom)" },
        "primaryCaller": { "type": "string", "description": "The family member responsible for personally inviting this guest" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "ownerId": { "type": "string", "description": "User ID of the wedding owner" }
      },
      "required": ["name", "category", "status", "createdAt", "ownerId"]
    },
    "Collaborator": {
      "title": "Collaborator",
      "description": "A family member or friend helping with the wedding",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Email of the collaborator" },
        "role": { "type": "string", "description": "Role (e.g. Father, Mother, Sibling)" },
        "name": { "type": "string", "description": "Name of the collaborator" },
        "addedAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["email", "role", "name", "addedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "A guest category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the category" },
        "ownerId": { "type": "string", "description": "User ID of the owner" }
      },
      "required": ["name", "ownerId"]
    },
    "WeddingSettings": {
      "title": "Wedding Settings",
      "description": "Global settings for the wedding",
      "type": "object",
      "properties": {
        "brideName": { "type": "string" },
        "groomName": { "type": "string" },
        "weddingDate": { "type": "string" },
        "venue": { "type": "string" },
        "whatsappTemplate": { "type": "string" },
        "greetingMessage": { "type": "string" },
        "invitationTone": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["brideName", "groomName", "weddingDate", "venue", "whatsappTemplate", "greetingMessage", "invitationTone", "ownerId"]
    },
    "SharedList": {
      "title": "Shared List",
      "description": "A list of guests shared via link",
      "type": "object",
      "properties": {
        "categoryName": { "type": "string" },
        "guests": { 
          "type": "array",
          "items": { "type": "object" }
        },
        "shareContacts": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["categoryName", "guests", "shareContacts", "createdBy", "createdAt"]
    }
  },
  "firestore": {
    "shared_lists/{sharedId}": {
      "schema": "SharedList",
      "description": "Publicly shared snapshots of guest lists"
    },
    "users/{userId}/guests/{guestId}": {
      "schema": "Guest",
      "description": "Collection of guests for a specific user"
    },
    "users/{userId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of categories for a specific user"
    },
    "users/{userId}/settings/info": {
      "schema": "WeddingSettings",
      "description": "Wedding settings for a specific user"
    },
    "users/{userId}/collaborators/{collabId}": {
      "schema": "Collaborator",
      "description": "List of collaborators who can manage this wedding"
    }
  }
}
